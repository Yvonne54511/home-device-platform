# 複製成專案根目錄的 .env 再改。此檔只有範例，沒有密鑰，可進版控。
# .env 已在 .gitignore，不要提交。

# 後端 FastAPI 監聽位址與埠（避開常見預設埠）
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8741

# 前端 Vite 開發伺服器埠
FRONTEND_PORT=5174

# 允許的前端來源（CORS）。本機開發用。
CORS_ORIGINS=http://127.0.0.1:5174,http://localhost:5174

# SQLite 檔案（*.db 不進版控）
DATABASE_URL=sqlite:///./home_device.db

# 背景輪詢間隔（秒）：讀 driver、寫遙測、套用控制
POLL_INTERVAL_SECONDS=2

# 抽水機最長連續運轉秒數。超過就強制停止並鎖定（預設 10 分鐘）
MAX_RUN_SECONDS=600
